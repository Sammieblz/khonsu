{
  "components": {
    "schemas": {
      "ApiError": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "items": {
              "type": "string"
            },
            "title": "Details",
            "type": "array"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ApiError",
        "type": "object"
      },
      "DisplaySettings": {
        "additionalProperties": false,
        "properties": {
          "stretch": {
            "default": "asinh",
            "enum": [
              "linear",
              "asinh"
            ],
            "title": "Stretch",
            "type": "string"
          },
          "vmax": {
            "title": "Vmax",
            "type": "number"
          },
          "vmin": {
            "title": "Vmin",
            "type": "number"
          }
        },
        "required": [
          "vmin",
          "vmax"
        ],
        "title": "DisplaySettings",
        "type": "object"
      },
      "Frame": {
        "additionalProperties": false,
        "properties": {
          "bandwidth_um": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bandwidth Um"
          },
          "detector": {
            "anyOf": [
              {
                "maximum": 6.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detector"
          },
          "frame_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Frame Id",
            "type": "string"
          },
          "image_url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Image Url",
            "type": "string"
          },
          "label": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Label",
            "type": "string"
          },
          "masked_fraction": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Masked Fraction",
            "type": "number"
          },
          "observation_id": {
            "anyOf": [
              {
                "maxLength": 160,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Id"
          },
          "observed_end_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed End Utc"
          },
          "observed_start_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed Start Utc"
          },
          "raster": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PreparedRaster"
              },
              {
                "type": "null"
              }
            ]
          },
          "release": {
            "anyOf": [
              {
                "enum": [
                  "DR1",
                  "QR3"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Release"
          },
          "source_fits_url": {
            "anyOf": [
              {
                "format": "uri",
                "maxLength": 2083,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Fits Url"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/QualityWarning"
            },
            "title": "Warnings",
            "type": "array"
          },
          "wavelength_um": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.75,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wavelength Um"
          }
        },
        "required": [
          "frame_id",
          "label",
          "image_url"
        ],
        "title": "Frame",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "live_processing_available": {
            "default": true,
            "title": "Live Processing Available",
            "type": "boolean"
          },
          "service": {
            "const": "khonsu-api",
            "default": "khonsu-api",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImageGrid": {
        "additionalProperties": false,
        "properties": {
          "height_px": {
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Height Px",
            "type": "integer"
          },
          "orientation": {
            "const": "north-up-east-left",
            "default": "north-up-east-left",
            "title": "Orientation",
            "type": "string"
          },
          "pixel_center_convention": {
            "const": "zero-based-integer-centers",
            "default": "zero-based-integer-centers",
            "title": "Pixel Center Convention",
            "type": "string"
          },
          "pixel_origin": {
            "const": "top-left",
            "default": "top-left",
            "title": "Pixel Origin",
            "type": "string"
          },
          "raster_to_wcs": {
            "anyOf": [
              {
                "enum": [
                  "identity",
                  "flip-y"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Raster To Wcs"
          },
          "wcs_header": {
            "anyOf": [
              {
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wcs Header"
          },
          "width_px": {
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Width Px",
            "type": "integer"
          }
        },
        "required": [
          "width_px",
          "height_px"
        ],
        "title": "ImageGrid",
        "type": "object"
      },
      "PreparedRaster": {
        "additionalProperties": false,
        "properties": {
          "encoding": {
            "const": "float32-le-mask8-v1",
            "default": "float32-le-mask8-v1",
            "title": "Encoding",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "title": "Sha256",
            "type": "string"
          },
          "size_bytes": {
            "exclusiveMinimum": 0.0,
            "maximum": 20971520.0,
            "title": "Size Bytes",
            "type": "integer"
          },
          "url": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "url",
          "size_bytes",
          "sha256"
        ],
        "title": "PreparedRaster",
        "type": "object"
      },
      "PresetTarget": {
        "additionalProperties": false,
        "properties": {
          "coordinate_frame": {
            "const": "ICRS",
            "default": "ICRS",
            "title": "Coordinate Frame",
            "type": "string"
          },
          "coordinate_note": {
            "title": "Coordinate Note",
            "type": "string"
          },
          "dec_deg": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dec Deg"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "object_type": {
            "title": "Object Type",
            "type": "string"
          },
          "preset_id": {
            "title": "Preset Id",
            "type": "string"
          },
          "ra_deg": {
            "anyOf": [
              {
                "exclusiveMaximum": 360.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ra Deg"
          }
        },
        "required": [
          "preset_id",
          "label",
          "object_type",
          "coordinate_note"
        ],
        "title": "PresetTarget",
        "type": "object"
      },
      "QualityWarning": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          },
          "message": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "QualityWarning",
        "type": "object"
      },
      "SequenceJob": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ApiError"
              },
              {
                "type": "null"
              }
            ]
          },
          "manifest_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Manifest Url"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "progress": {
            "default": 0.0,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Progress",
            "type": "number"
          },
          "sequence_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Sequence Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "queued",
              "retrieving",
              "processing",
              "ready",
              "failed",
              "cancelled",
              "expired"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "sequence_id",
          "status"
        ],
        "title": "SequenceJob",
        "type": "object"
      },
      "SequenceManifest": {
        "additionalProperties": false,
        "properties": {
          "data_mode": {
            "enum": [
              "synthetic",
              "cached-real",
              "live"
            ],
            "title": "Data Mode",
            "type": "string"
          },
          "disclosure": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Disclosure",
            "type": "string"
          },
          "display": {
            "$ref": "#/components/schemas/DisplaySettings"
          },
          "frames": {
            "items": {
              "$ref": "#/components/schemas/Frame"
            },
            "maxItems": 96,
            "minItems": 2,
            "title": "Frames",
            "type": "array"
          },
          "grid": {
            "$ref": "#/components/schemas/ImageGrid"
          },
          "processing": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "boolean"
                }
              ]
            },
            "title": "Processing",
            "type": "object"
          },
          "requested_fov_arcmin": {
            "maximum": 120.0,
            "minimum": 0.5,
            "title": "Requested Fov Arcmin",
            "type": "number"
          },
          "schema_version": {
            "const": "1.0",
            "default": "1.0",
            "title": "Schema Version",
            "type": "string"
          },
          "sequence_id": {
            "pattern": "^[a-zA-Z0-9_-]{1,80}$",
            "title": "Sequence Id",
            "type": "string"
          },
          "target": {
            "$ref": "#/components/schemas/SkyTarget"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "warnings": {
            "items": {
              "$ref": "#/components/schemas/QualityWarning"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "sequence_id",
          "data_mode",
          "title",
          "disclosure",
          "target",
          "requested_fov_arcmin",
          "grid",
          "display",
          "frames"
        ],
        "title": "SequenceManifest",
        "type": "object"
      },
      "SequenceRequest": {
        "additionalProperties": false,
        "properties": {
          "coordinate_frame": {
            "const": "ICRS",
            "default": "ICRS",
            "title": "Coordinate Frame",
            "type": "string"
          },
          "dec_deg": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Dec Deg",
            "type": "number"
          },
          "detector": {
            "anyOf": [
              {
                "maximum": 6.0,
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detector"
          },
          "end_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "End Utc"
          },
          "fov_arcmin": {
            "default": 6.0,
            "maximum": 120.0,
            "minimum": 0.5,
            "title": "Fov Arcmin",
            "type": "number"
          },
          "max_frames": {
            "default": 24,
            "maximum": 96.0,
            "minimum": 2.0,
            "title": "Max Frames",
            "type": "integer"
          },
          "ra_deg": {
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Ra Deg",
            "type": "number"
          },
          "start_utc": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Utc"
          },
          "wavelength_max_um": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.75,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wavelength Max Um"
          },
          "wavelength_min_um": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.75,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Wavelength Min Um"
          }
        },
        "required": [
          "ra_deg",
          "dec_deg"
        ],
        "title": "SequenceRequest",
        "type": "object"
      },
      "SkyTarget": {
        "additionalProperties": false,
        "properties": {
          "coordinate_frame": {
            "const": "ICRS",
            "default": "ICRS",
            "title": "Coordinate Frame",
            "type": "string"
          },
          "dec_deg": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Dec Deg",
            "type": "number"
          },
          "ra_deg": {
            "exclusiveMaximum": 360.0,
            "minimum": 0.0,
            "title": "Ra Deg",
            "type": "number"
          }
        },
        "required": [
          "ra_deg",
          "dec_deg"
        ],
        "title": "SkyTarget",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Explore genuine IRSA SPHEREx observations through bounded retrieval and scientific processing. Synthetic development imagery is opt-in.",
    "title": "Khonsu API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "system"
        ]
      }
    },
    "/v1/demo/frames/{filename}": {
      "get": {
        "operationId": "synthetic_frame_v1_demo_frames__filename__get",
        "parameters": [
          {
            "in": "path",
            "name": "filename",
            "required": true,
            "schema": {
              "title": "Filename",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Synthetic Frame",
        "tags": [
          "synthetic development demo"
        ]
      }
    },
    "/v1/demo/manifest": {
      "get": {
        "operationId": "synthetic_manifest_v1_demo_manifest_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SequenceManifest"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Synthetic Manifest",
        "tags": [
          "synthetic development demo"
        ]
      }
    },
    "/v1/examples": {
      "get": {
        "operationId": "examples_v1_examples_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SequenceManifest"
                  },
                  "title": "Response Examples V1 Examples Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Examples",
        "tags": [
          "discovery"
        ]
      }
    },
    "/v1/examples/{example_id}/frames/{filename}": {
      "get": {
        "operationId": "example_frame_v1_examples__example_id__frames__filename__get",
        "parameters": [
          {
            "in": "path",
            "name": "example_id",
            "required": true,
            "schema": {
              "pattern": "^[a-zA-Z0-9_-]{1,80}$",
              "title": "Example Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "filename",
            "required": true,
            "schema": {
              "title": "Filename",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Example Frame",
        "tags": [
          "discovery"
        ]
      }
    },
    "/v1/presets": {
      "get": {
        "operationId": "presets_v1_presets_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PresetTarget"
                  },
                  "title": "Response Presets V1 Presets Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Presets",
        "tags": [
          "discovery"
        ]
      }
    },
    "/v1/sequences": {
      "post": {
        "operationId": "create_sequence_v1_sequences_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SequenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SequenceJob"
                }
              }
            },
            "description": "Successful Response"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Conflict"
          },
          "410": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Gone"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "507": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Insufficient Storage"
          }
        },
        "summary": "Create Sequence",
        "tags": [
          "sequences"
        ]
      }
    },
    "/v1/sequences/{sequence_id}": {
      "get": {
        "operationId": "sequence_status_v1_sequences__sequence_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "sequence_id",
