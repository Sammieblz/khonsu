# Docker Compose browser origin. Public and compiled into frontend builds.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# CORS is an allowlist, not authentication.
KHONSU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Scientific packages are installed for live processing.
INSTALL_SCIENCE=true

# Optional named Cloudflare Tunnel overlay. Never put a connector token here.
KHONSU_TUNNEL_TOKEN_FILE=./.secrets/cloudflare-tunnel-token
# Add the exact Pages project origin here if visitors use its pages.dev URL.
KHONSU_TUNNEL_CORS_ORIGINS=https://khonsulive.earth,https://www.khonsulive.earth,http://localhost:3000,http://127.0.0.1:3000

