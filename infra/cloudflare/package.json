{
  "name": "khonsu-cloudflare-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc",
    "types": "wrangler types worker-configuration.d.ts --config wrangler.jsonc",
    "typecheck": "npm run types && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/http.test.ts",
    "check": "npm run typecheck && npm test",
    "bundle": "wrangler deploy --dry-run --config wrangler.jsonc --outdir .wrangler/dry-run",
    "deploy": "wrangler deploy --config wrangler.jsonc"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wrangler": "4.162.0"
  }
}
